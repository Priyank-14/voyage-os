# VoyageOS Configuration Environment Template
# Copy this file to .env and fill in your API credentials.
# NOTE: VoyageOS is designed with resilient fallback adapters and simulation modes,
# so the full system can run seamlessly even without external API keys.

# Environment & Observability
VOYAGEOS_ENV=development
VOYAGEOS_DEBUG=true
VOYAGEOS_LOG_LEVEL=INFO

# Model Provider (Options: 'mock', 'gemini', 'openai')
VOYAGEOS_MODEL_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=

# External Tool Credentials (Optional - fallback simulation providers active by default)
OPENWEATHER_API_KEY=
GOOGLE_MAPS_API_KEY=

# Database Settings
DATABASE_PATH=data/voyageos.db

# Simulation & Re-Planning Policies
SIMULATION_MODE=true
RAIN_DISRUPTION_THRESHOLD_PERCENT=70
BUDGET_WARNING_THRESHOLD_PERCENT=85
DEFAULT_ALTERNATIVE_SCORE_WEIGHTS={"preference":0.30,"constraint":0.25,"budget":0.20,"travel":0.15,"safety":0.10}
